# Application
APP_NAME=UniTrust
APP_ENV=development
DEBUG=true

# API
API_HOST=127.0.0.1
API_PORT=8000

# Demo data runtime. For the monitored demo, point these to one external
# runtime root; do not point a monitor at the repository's protected snapshot.
DATABASE_URL=sqlite:///./unitrust.db
RETRIEVAL_CACHE_DIR=data/processed/retrieval
DENSE_LOCAL_FILES_ONLY=false

# Optional separate monitoring worker. The web processes never start it.
MONITORING_ENABLED=false
MONITORING_INTERVAL_SECONDS=600
MONITORING_RAW_DATA_DIR=data/v2-monitoring/raw
MONITORING_RECENT_WINDOW_HOURS=48

# Offline demo loading. Set true for the prepared local E5 model snapshot.
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0

# Streamlit API endpoint when the frontend runs separately.
API_BASE_URL=http://127.0.0.1:8000

# Optional local OCR sidecar. OCR is not required for text verification.
# UNITRUST_OCR_PYTHON=C:\\path\\to\\isolated-ocr-runtime\\Scripts\\python.exe
# UNITRUST_OCR_MODEL_ROOT=C:\\path\\to\\local-ocr-models
# UNITRUST_OCR_SIDECAR_URL=http://127.0.0.1:8765

# Optional legacy/provider settings. They are not required for the demo and
# must remain blank unless a separately approved experiment needs them.
STRUCTURED_AI_ENABLED=false
LLM_API_KEY=
LLM_PROVIDER=ollama
OPENAI_API_KEY=
